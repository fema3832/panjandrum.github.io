---
const {
  title = 'Default Title',
  description = 'Default description text.',
  nexthref = '#nexthref',
  ctaText,
  ctaHref,
} = Astro.props;
---

<section class="w-full relative flex items-center justify-center overflow-hidden min-h-[calc(100dvh-60px)]">
  <!-- <img src={image} alt="" class="absolute inset-0 w-full h-full object-cover grayscale opacity-60" /> -->
  <div class="absolute inset-0 bg-linear-to-t from-transparent via-neutral-950/70 to-neutral-950/30"></div>

  <div class="relative container mx-auto px-4 text-center text-white max-w-4xl">
    <div class="inline-block bg-yellow-400 px-5 py-3 sm:px-10 sm:py-6 mb-6">
      <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold uppercase tracking-tight leading-tight text-neutral-950">
        {title}
      </h1>
    </div>

    <p class="mx-auto mb-8 sm:mb-10 max-w-sm sm:max-w-lg font-semibold text-xl md:text-2xl text-slate-200">
      {description}
    </p>

    {ctaText && ctaHref && (
      <a
        href={ctaHref}
        class="inline-block border-2 border-white text-white font-semibold uppercase tracking-wide text-sm sm:text-base px-6 py-3 sm:px-8 sm:py-4 hover:bg-white hover:text-neutral-950 transition-colors duration-200"
      >
        {ctaText}
      </a>
    )}
  </div>

  <div class="absolute bottom-32 left-1/2 -translate-x-1/2 z-10">
    <a
      href={nexthref}
      class="text-white/70 hover:text-yellow-400 transition-colors duration-200 animate-bounce block"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
        class="size-14 sm:size-20 md:hover:size-22 lg:hover:size-24 transition-all duration-200"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="m19.5 8.25-7.5 7.5-7.5-7.5"
        />
      </svg>
    </a>
  </div>
</section>
