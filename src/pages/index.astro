---
import TextSection from '../components/textsection.astro';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/hero.astro';

import { Image } from 'astro:assets';
import sound from '../assets/hdl20.jpg';
import light from '../assets/light.jpg';
import video from '../assets/video.jpg';
import about from '../assets/about.jpg';
import reference from '../assets/reference.jpg';
import contact from '../assets/contact.jpg';

import ease_focus from '../assets/ease_focus.png';
import chamsys_visualizer from '../assets/chamsys_visualizer.png';
---

<Layout>
  <Hero nexthref={'#cards'} />

  <section class="pt-16 md:pt-20">
    <div class="text-center px-4">
      <h2 class="text-white font-bold text-3xl sm:text-4xl md:text-5xl">
        Ismerjen meg minket jobban!
      </h2>
    </div>
  </section>

  <section class="relative overflow-hidden scroll-mt-42" id="cards">
    <div class="absolute inset-0 bg-linear-to-t from-yellow-400/50 to-transparent pointer-events-none"></div>
    <div class="relative flex-col w-full flex items-center justify-center pt-12 md:pt-24">
      <div class="container mx-auto px-4 text-white max-w-6xl w-full">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-4 md:gap-6 w-full">
          <!-- 4. KÁRTYA -->
          <div class="relative overflow-hidden lg:col-span-2 shadow-lg shadow-yellow-900/10 border-2 border-yellow-400">
            <a href="/about/" class="group block">
              <Image
                src={about}
                width={800}
                height={600}
                alt=""
                class="aspect-video w-full object-cover block brightness-60 group-hover:brightness-90 transition-all duration-200"
              />
              <h2 class="absolute bottom-0 left-0 m-0 text-white font-bold text-2xl leading-tight wrap-break-word px-3 py-3 w-full bg-neutral-900/50 tracking-wider uppercase group-hover:text-yellow-400 transition-all duration-200">
                Rólunk
              </h2>
            </a>
          </div>

          <!-- 5. KÁRTYA -->
          <div class="relative overflow-hidden lg:col-span-2 shadow-lg shadow-yellow-900/10 border-2 border-yellow-400">
            <a href="/reference/" class="group block">
              <Image
                src={reference}
                width={800}
                height={600}
                alt=""
                class="aspect-video w-full object-cover block brightness-60 group-hover:brightness-90 transition-all duration-200"
              />
              <h2 class="absolute bottom-0 left-0 m-0 text-white font-bold text-2xl leading-tight wrap-break-word px-3 py-3 w-full bg-neutral-900/50 tracking-wider uppercase group-hover:text-yellow-400 transition-all duration-200">
                Referencia
              </h2>
            </a>
          </div>

          <!-- 6. KÁRTYA -->
          <div class="relative overflow-hidden lg:col-span-2 shadow-lg shadow-yellow-900/10 border-2 border-yellow-400">
            <a href="/contact/" class="group block">
              <Image
                src={contact}
                width={800}
                height={600}
                alt=""
                class="aspect-video w-full object-cover block brightness-60 group-hover:brightness-90 transition-all duration-200"
              />
              <h2 class="absolute bottom-0 left-0 m-0 text-white font-bold text-2xl leading-tight wrap-break-word px-3 py-3 w-full bg-neutral-900/50 tracking-wider uppercase group-hover:text-yellow-400 transition-all duration-200">
                Kapcsolat
              </h2>
            </a>
          </div>

          <!-- 1. KÁRTYA -->
          <div class="relative overflow-hidden lg:col-span-2 shadow-lg shadow-yellow-900/10 border-2 border-yellow-400">
            <a href="/services/sound/" class="group block">
              <Image
                src={sound}
                width={800}
                height={600}
                alt=""
                class="aspect-video w-full object-cover block brightness-60 group-hover:brightness-90 transition-all duration-200"
              />
              <h2 class="absolute bottom-0 left-0 m-0 text-white font-bold text-2xl leading-tight wrap-break-word px-3 py-3 w-full bg-neutral-900/50 tracking-wider uppercase group-hover:text-yellow-400 transition-all duration-200">
                Hangtechnika
              </h2>
            </a>
          </div>

          <!-- 2. KÁRTYA -->
          <div class="relative overflow-hidden lg:col-span-2 shadow-lg shadow-yellow-900/10 border-2 border-yellow-400">
            <a href="/services/light/" class="group block">
              <Image
                src={light}
                width={800}
                height={600}
                alt=""
                class="aspect-video w-full object-cover block brightness-60 group-hover:brightness-90 transition-all duration-200"
              />
              <h2 class="absolute bottom-0 left-0 m-0 text-white font-bold text-2xl leading-tight wrap-break-word px-3 py-3 w-full bg-neutral-900/50 tracking-wider uppercase group-hover:text-yellow-400 transition-all duration-200">
                Fénytechnika
              </h2>
            </a>
          </div>

          <!-- 3. KÁRTYA -->
          <div class="relative overflow-hidden lg:col-span-2 shadow-lg shadow-yellow-900/10 border-2 border-yellow-400">
            <a href="/services/video/" class="group block">
              <Image
                src={video}
                width={800}
                height={600}
                alt=""
                class="aspect-video w-full object-cover block brightness-60 group-hover:brightness-90 transition-all duration-200"
              />
              <h2 class="absolute bottom-0 left-0 m-0 text-white font-bold text-2xl leading-tight wrap-break-word px-3 py-3 w-full bg-neutral-900/50 tracking-wider uppercase group-hover:text-yellow-400 transition-all duration-200">
                Vetítéstechnika
              </h2>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-linear-to-t from-transparent to-yellow-400/50 py-12 sm:py-16 md:py-20">
    <div class="container mx-auto px-4 max-w-6xl">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
        <div
          class="bg-neutral-900/90 border-2 border-yellow-400 p-6 md:p-8 flex flex-col items-center justify-center text-center min-h-35"
          x-data="{ count: 0, target: 12 }"
          x-intersect.once="let start = null; function step(ts){ if(!start) start = ts; let progress = Math.min((ts - start) / 1500, 1); count = Math.floor(progress * target); if (progress < 1) requestAnimationFrame(step); else count = target; } requestAnimationFrame(step);"
        >
          <p
            class="text-2xl sm:text-3xl lg:text-5xl font-bold text-yellow-400 leading-none"
            x-text="count + '+'"
          >
            0+
          </p>
          <p class="mt-3 text-sm sm:text-base lg:text-lg uppercase tracking-wider text-neutral-300">
            Év tapasztalat
          </p>
        </div>

        <div
          class="bg-neutral-900/90 border-2 border-yellow-400 p-6 md:p-8 flex flex-col items-center justify-center text-center min-h-35"
          x-data="{ count: 0, target: 120 }"
          x-intersect.once="let start = null; function step(ts){ if(!start) start = ts; let progress = Math.min((ts - start) / 1500, 1); count = Math.floor(progress * target); if (progress < 1) requestAnimationFrame(step); else count = target; } requestAnimationFrame(step);"
        >
          <p
            class="text-2xl sm:text-3xl lg:text-5xl font-bold text-yellow-400 leading-none"
            x-text="count + '+'"
          >
            0+
          </p>
          <p class="mt-3 text-sm sm:text-base lg:text-lg uppercase tracking-wider text-neutral-300">
            Lebonyolított rendezvény
          </p>
        </div>

        <div
          class="bg-neutral-900/90 border-2 border-yellow-400 p-6 md:p-8 flex flex-col items-center justify-center text-center min-h-35"
          x-data="{ count: 0, target: 50 }"
          x-intersect.once="let start = null; function step(ts){ if(!start) start = ts; let progress = Math.min((ts - start) / 1500, 1); count = Math.floor(progress * target); if (progress < 1) requestAnimationFrame(step); else count = target; } requestAnimationFrame(step);"
        >
          <p
            class="text-2xl sm:text-3xl lg:text-5xl font-bold text-yellow-400 leading-none"
            x-text="count + '+'"
          >
            0+
          </p>
          <p class="mt-3 text-sm sm:text-base lg:text-lg uppercase tracking-wider text-neutral-300">
            Helyszín
          </p>
        </div>

        <div
          class="bg-neutral-900/90 border-2 border-yellow-400 p-6 md:p-8 flex flex-col items-center justify-center text-center min-h-35"
          x-data="{ count: 0, target: 3 }"
          x-intersect.once="let start = null; function step(ts){ if(!start) start = ts; let progress = Math.min((ts - start) / 1500, 1); count = Math.floor(progress * target); if (progress < 1) requestAnimationFrame(step); else count = target; } requestAnimationFrame(step);"
        >
          <p
            class="text-2xl sm:text-3xl lg:text-5xl font-bold text-yellow-400 leading-none"
            x-text="count"
          >
            0
          </p>
          <p class="mt-3 text-sm sm:text-base lg:text-lg uppercase tracking-wider text-neutral-300">
            Szolgáltatási terület
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-12 sm:py-16 md:py-20">
    <TextSection
      title1={`Pontos lefedettség <span class="text-yellow-400">Ease Focus szoftverrel</span>`}
      description1="Rendezvény előtt Ease Focus szoftverrel megtervezzük a hangsugárzók elhelyezését és lefedettségét. Így már előre pontosan tudjuk, hogyan szól majd a hangzás a nézőtér minden pontján, ami gyorsabbá és pontosabbá teszi a helyszíni beüzemelést."
      img1={ease_focus}

      title2={`Fényvilág <span class="text-yellow-400">leszimulálása</span> rendezvény előtt`}
      description2="ChamSys MagicQ szoftverrel a fényvilágot már a helyszínre érkezés előtt megtervezzük és leteszteljük. Így a rendezvény napján minden fény pontosan úgy mozog és világít, ahogyan azt előre megterveztük."
      img2={chamsys_visualizer}
    />
  </section>

  <section class="py-20 md:py-28">
    <div class="container mx-auto px-4 max-w-4xl text-center">
      <div class="w-12 h-1 bg-yellow-400 rounded-full mx-auto mb-8"></div>
      <p class="text-white font-bold text-xl md:text-3xl lg:text-4xl leading-snug">
        Korszerű hang- és fénytechnikával, valamint páratlan, teljes körű
        kiszolgálással váltjuk valóra partnereink elképzeléseit.
      </p>
      <div class="w-12 h-1 bg-yellow-400 rounded-full mx-auto mt-8"></div>
    </div>
  </section>
</Layout>
