              <strong class="text-white">
                Bejegyző / Nyilvántartó hatóság:
              </strong>{' '}
              NAV (Nemzeti Adó- és Vámhivatal)
            </p>
            <p>
              <strong class="text-white">Kamarai tagság:</strong>{' '}
              Komárom-Esztergom Megyei Kereskedelmi és Iparkamara (KEMKIK)
            </p>
          </div>
        </div>

        <!-- ELÉRHETŐSÉGEK -->
        <div>
          <h2 class="text-xl font-semibold text-white mb-4">
            2. Kapcsolattartás és elérhetőség
          </h2>
          <div class="bg-neutral-950 p-6 rounded-lg border border-neutral-800 space-y-3">
            <p>
              <strong class="text-white">Telefonszám:</strong> +36 30 972 7444
            </p>
            <p>
              <strong class="text-white">E-mail cím:</strong> ftboy01@gmail.com
            </p>
            <p>
              <strong class="text-white">Weboldal:</strong>{' '}
              https://panjandrum.hu
            </p>
          </div>
        </div>

        <!-- TÁRHELYSZOLGÁLTATÓ -->
        <div>
          <h2 class="text-xl font-semibold text-white mb-4">
            3. A tárhelyszolgáltató adatai
          </h2>
          <div class="bg-neutral-950 p-6 rounded-lg border border-neutral-800 space-y-3">
            <p>
              <strong class="text-white">Név:</strong> GitHub, Inc.
            </p>
            <p>
              <strong class="text-white">Székhely:</strong> 88 Colin P Kelly Jr
              St, San Francisco, CA 94107, USA
            </p>
            <p>
              <strong class="text-white">E-mail:</strong> support@github.com
            </p>
            <p>
              <strong class="text-white">Weboldal:</strong>{' '}
              https://pages.github.com
            </p>
          </div>
        </div>

        <!-- DOMAINSZOLGÁLTATÓ -->
        <div>
          <h2 class="text-xl font-semibold text-white mb-4">
            4. A domainszolgáltató adatai
