---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/hero.astro';

import { Image } from 'astro:assets';
import sound from '../assets/hdl20.jpg';
import light from '../assets/light.jpg';
import video from '../assets/video.jpg';
import about from '../assets/about.jpg';
import reference from '../assets/reference.jpg';
import contact from '../assets/contact.jpg';
---

<Layout>
  <Hero nexthref={'#cards'} />

  <section class="flex-col w-full flex items-center justify-center overflow-hidden bg-linear-to-t from-transparent via-yellow-500/50 py-16 md:py-28 lg:py-45">
    <div class="flex mb-10 md:mb-16 px-4 text-center">
      <h2 class="text-white font-bold text-3xl sm:text-4xl md:text-5xl lg:text-6xl rounded">
        Ismerjen meg minket jobban!
      </h2>
    </div>
    <div class="relative container mx-auto px-4 text-white max-w-6xl w-full">
      <div
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-1 w-full scroll-mt-72"
        id="cards"
      >
        <!-- 4. KÁRTYA -->
        <div class="relative overflow-hidden lg:col-span-2">
          <a href="/about/" class="group block">
            <Image
              src={about}
              width={800}
              height={600}
              alt=""
              class="aspect-video w-full object-cover block brightness-60 group-hover:brightness-90 transition-all duration-200"
            />
            <h2 class="absolute bottom-0 left-0 right-2 m-0 text-white font-bold text-2xl leading-tight wrap-break-word px-3 py-3 w-full bg-neutral-900/50 tracking-wider uppercase group-hover:text-yellow-400 transition-all duration-200">
              Rólunk
            </h2>
          </a>
        </div>

        <!-- 5. KÁRTYA -->
        <div class="relative overflow-hidden lg:col-span-2">
          <a href="/reference/" class="group block">
            <Image
              src={reference}
              width={800}
              height={600}
              alt=""
              class="aspect-video w-full object-cover block brightness-60 group-hover:brightness-90 transition-all duration-200"
            />
            <h2 class="absolute bottom-0 left-0 right-2 m-0 text-white font-bold text-2xl leading-tight wrap-break-word px-3 py-3 w-full bg-neutral-900/50 tracking-wider uppercase group-hover:text-yellow-400 transition-all duration-200">
              Referencia
            </h2>
          </a>
        </div>

        <!-- 6. KÁRTYA -->
        <div class="relative overflow-hidden lg:col-span-2">
          <a href="/contact/" class="group block">
            <Image
              src={contact}
              width={800}
              height={600}
              alt=""
              class="aspect-video w-full object-cover block brightness-60 group-hover:brightness-90 transition-all duration-200"
            />
            <h2 class="absolute bottom-0 left-0 right-2 m-0 text-white font-bold text-2xl leading-tight wrap-break-word px-3 py-3 w-full bg-neutral-900/50 tracking-wider uppercase group-hover:text-yellow-400 transition-all duration-200">
              Kapcsolat
            </h2>
          </a>
        </div>

        <!-- 1. KÁRTYA -->
        <div class="relative overflow-hidden lg:col-span-2">
          <a href="/services/sound/" class="group block">
            <Image
              src={sound}
              width={800}
              height={600}
              alt=""
              class="aspect-video w-full object-cover block brightness-60 group-hover:brightness-90 transition-all duration-200"
            />
            <h2 class="absolute bottom-0 left-0 right-2 m-0 text-white font-bold text-2xl leading-tight wrap-break-word px-3 py-3 w-full bg-neutral-900/50 tracking-wider uppercase group-hover:text-yellow-400 transition-all duration-200">
              Hangtechnika
            </h2>
          </a>
        </div>

        <!-- 2. KÁRTYA -->
        <div class="relative overflow-hidden lg:col-span-2">
          <a href="/services/light/" class="group block">
            <Image
              src={light}
              width={800}
              height={600}
              alt=""
              class="aspect-video w-full object-cover block brightness-60 group-hover:brightness-90 transition-all duration-200"
            />
            <h2 class="absolute bottom-0 left-0 right m-0 text-white font-bold text-2xl leading-tight wrap-break-word px-3 py-3 w-full bg-neutral-900/50 tracking-wider uppercase group-hover:text-yellow-400 transition-all duration-200">
              Fénytechnika
            </h2>
          </a>
        </div>

        <!-- 3. KÁRTYA -->
        <div class="relative overflow-hidden lg:col-span-2">
          <a href="/services/video/" class="group block">
            <Image
              src={video}
              width={800}
              height={600}
              alt=""
              class="aspect-video w-full object-cover block brightness-60 group-hover:brightness-90 transition-all duration-200"
            />
            <h2 class="absolute bottom-0 left-0 right-2 m-0 text-white font-bold text-2xl leading-tight wrap-break-word px-3 py-3 w-full bg-neutral-900/50 tracking-wider uppercase group-hover:text-yellow-400 transition-all duration-200">
              Vetítéstechnika
            </h2>
          </a>
        </div>
      </div>
      <div class="flex flex-col lg:flex-row mt-12 w-full md:w-10/12 mx-auto gap-5 justify-center items-center text-center">
        <hr class="w-full lg:w-16 shrink-0" />
        <h2 class="text-white font-bold text-xl md:text-3xl lg:text-4xl rounded">
          Korszerű hang- és fénytechnikával, valamint páratlan, teljes körű
          kiszolgálással váltjuk valóra partnereink elképzeléseit.
        </h2>
        <hr class="w-full lg:w-16 shrink-0" />
      </div>
    </div>
  </section>
</Layout>
