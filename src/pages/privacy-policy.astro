---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <section class="py-16 bg-linear-to-t from-transparent to-neutral-900 text-slate-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl font-bold text-white mb-8 border-b border-neutral-800 pb-4">
        Impresszum
      </h1>

      <div class="space-y-8">
        <!-- A SZOLGÁLTATÓ ADATAI -->
        <div>
          <h2 class="text-xl font-semibold text-white mb-4">
            1. A szolgáltató adatai
          </h2>
          <div class="bg-neutral-950 p-6 rounded-lg border border-neutral-800 space-y-3">
            <p>
              <strong class="text-white">Cégnév / Név:</strong> Fejes Tibor E.
              V.
            </p>
            <p>
              <strong class="text-white">Székhely:</strong> 2890, Tata, Látóhegy
              15792/1
            </p>
            <p>
              <strong class="text-white">Postacím:</strong> 2890, Tata, Látóhegy
              15792/1
            </p>
            <p>
              <strong class="text-white">Adószám:</strong> 62746395-2-31
            </p>
            <p>
