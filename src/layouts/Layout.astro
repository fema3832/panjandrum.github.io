---
import { SEO } from 'astro-seo';
import { AstroFont } from 'astro-font';
import { Schema } from 'astro-seo-schema';
import { ClientRouter } from 'astro:transitions';
import Navbar from '../components/navbar.astro';
import Footer from '../components/footer.astro';
import VideoHero from '../components/videohero.astro';
import '../styles/global.css';
---

<!doctype html>
<html lang="hu">
  <head>
    <ClientRouter />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <!-- Előzetes kapcsolat a Google Fonts CDN-hez, hogy a betűtípus
         betöltése ne lassítsa az első festést (LCP). -->
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <AstroFont
      config={[
        {
          name: 'Inter',
          src: [],
          googleFontsURL:
            'https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap',
          preload: true,
          display: 'swap',
          selector: 'body',
          fallback: 'sans-serif',
        },
      ]}
    />
    <link
      rel="icon"
      type="image/x-icon"
      href="/icons/favicon.ico"
      sizes="any"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/icons/favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/icons/favicon-16x16.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/icons/apple-touch-icon.png"
    />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#facc15" />
    <SEO
      title="Panjandrum - Hangtechnika és Fénytechnika Rendezvényekre"
      titleTemplate="%s | Panjandrum"
      description="Profi hang-, fény- és színpadtechnika koncertekre, esküvőkre, falunapokra és céges rendezvényekre 1992 óta, Tatán és Komárom-Esztergom megyében."
      canonical="https://panjandrum.hu/"
      openGraph={{
        basic: {
          title: 'Panjandrum - Hangtechnika és Fénytechnika Rendezvényekre',
          type: 'website',
          image: 'https://panjandrum.hu/videos/background.webp',
        },
        optional: {
          description:
            'Profi hang-, fény- és színpadtechnika koncertekre, esküvőkre, falunapokra és céges rendezvényekre 1992 óta, Tatán és Komárom-Esztergom megyében.',
          siteName: 'Panjandrum',
          locale: 'hu_HU',
        },
      }}
      twitter={{ card: 'summary_large_image' }}
    />
    <Schema
      item={{
        '@context': 'https://schema.org',
        '@type': 'LocalBusiness',
        '@id': 'https://panjandrum.hu/#organization',
        name: 'Panjandrum',
        description:
          'Rendezvénytechnikai szolgáltatások: hangtechnika, fénytechnika, színpad és kordon kivitelezése koncertekre, esküvőkre, falunapokra és céges rendezvényekre 1992 óta.',
        url: 'https://panjandrum.hu',
        image: 'https://panjandrum.hu/videos/background.webp',
        telephone: '+36309727444',
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Tata',
          addressRegion: 'Komárom-Esztergom',
          addressCountry: 'HU',
        },
        areaServed: [
          'Tata',
          'Komárom',
          'Szőny',
          'Baj',
          'Tököl',
          'Visegrád',
          'Komárom-Esztergom megye',
        ],
      }}
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- A háttérvideó poster képe a legnagyobb, látható felületi elem (LCP),
         ezért előre betöltjük: így nem kell megvárni a CSS feldolgozását. -->
    <link
      rel="preload"
      as="image"
      href="/videos/background.webp"
      fetchpriority="high"
    />

    <style is:global>
      img:not([src$='.svg']):not([data-no-skeleton]) {
        background-color: #262626;
      }
      img:not([src$='.svg']):not([data-no-skeleton]):not(.is-loaded) {
        animation: skeleton-pulse 1.6s ease-in-out infinite;
      }
      @keyframes skeleton-pulse {
        0%,
        100% {
          opacity: 1;
        }
        50% {
          opacity: 0.6;
        }
      }
    </style>

    <script>
      const SKELETON_IMG_SELECTOR =
        "img:not([src$='.svg']):not([data-no-skeleton])";

      function trackImageLoad(img: HTMLImageElement) {
        if (img.dataset.skeletonTracked === 'true') return;
        img.dataset.skeletonTracked = 'true';

        const markLoaded = () => img.classList.add('is-loaded');

        // naturalWidth > 0 is required: an <img> with no src yet (or a broken
        // one) still reports complete === true, which would hide the skeleton
        // before anything was actually rendered.
        if (img.complete && img.naturalWidth > 0) {
          markLoaded();
          return;
        }

        img.addEventListener('load', markLoaded, { once: true });
        // Never pulse forever on a 404.
        img.addEventListener('error', markLoaded, { once: true });
      }

      function trackImagesIn(root: ParentNode) {
        root
          .querySelectorAll<HTMLImageElement>(SKELETON_IMG_SELECTOR)
          .forEach(trackImageLoad);
      }

      // Re-scan on the first load AND after every <ClientRouter /> navigation.
      // Without this the script only ever runs once, so images injected by
      // client-side navigation keep pulsing forever even though they loaded.
      document.addEventListener('astro:page-load', () =>
        trackImagesIn(document)
      );

      trackImagesIn(document);

      // Catch images added later by Alpine (e.g. the reference lightbox).
      new MutationObserver((mutations) => {
        for (const mutation of mutations) {
          mutation.addedNodes.forEach((node) => {
            if (!(node instanceof Element)) return;
            if (node instanceof HTMLImageElement) trackImageLoad(node);
            trackImagesIn(node);
          });
        }
      }).observe(document.documentElement, { childList: true, subtree: true });
    </script>
  </head>
  <body class="flex flex-col min-h-screen bg-neutral-900 glass">
    <section>
      <VideoHero />
      <Navbar />
      <main class="grow glass bg-neutral-900/70">
        <slot />
        <Footer />
      </main>
    </section>
  </body>
</html>
