<video
  autoplay
  muted
  loop
  playsinline
  preload="metadata"
  poster="/videos/background.webp"
  class="absolute -z-10 min-w-full min-h-full object-cover grayscale"
  aria-hidden="true"
  transition:persist
>
  <!-- <source src="/videos/background.webm" type="video/webm" /> -->
  <!-- background_loop.mp4: 1.5x lassított, MCIdatás (mozgás-követő) frame
       interpolációval – NEM frame duplikálással, ezért nincs "laggy" ugrás.
       A videó eleje (0-1.5s) fordítottan a végére van crossfade-elve, így a
       visszajátszás varratmentes (seam PSNR: 9.5 dB -> 33 dB).
       FFmpeg faststart-tal (moov az mdat elé kerül) rendelkezésre áll. -->
  <source src="/videos/background_loop.mp4" type="video/mp4" />
</video>

<style>
  /* A dekoratív háttérvideó nem játsszon le, ha a felhasználó csökkentett
     mozgást kért. A poster (60 KB) ilyenkor is látszik a sötét háttéren. */
  @media (prefers-reduced-motion: reduce) {
    video {
      display: none;
    }
  }
</style>

<script>
  // A <video> transition:persisttel megmarad a navigációk között, így a
  // script csak egyszer fut le – elég, hogy egyszer kikapcsoljuk a lejátszást.
  const bgVideo = document.querySelector<HTMLVideoElement>('video');
  if (
    bgVideo &&
    window.matchMedia('(prefers-reduced-motion: reduce)').matches
  ) {
    bgVideo.pause();
    bgVideo.removeAttribute('autoplay');
  }
</script>
